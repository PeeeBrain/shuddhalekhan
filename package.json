{
  "name": "shuddhalekhan-monorepo",
  "private": true,
  "version": "0.0.0-development",
  "workspaces": [
    "app",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev": "bun run dev:app",
    "dev:app": "bun run --cwd app dev",
    "dev:web": "bun run --cwd web dev",
    "check": "bun run --parallel typecheck lint test",
    "typecheck": "bun run --parallel --filter \"@shuddhalekhan/*\" typecheck",
    "lint": "bun run --parallel --filter \"@shuddhalekhan/*\" lint",
    "lint:fix": "bun run --parallel --filter \"@shuddhalekhan/*\" lint:fix",
    "test": "bun run --cwd app test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
