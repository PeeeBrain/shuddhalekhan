{
  "name": "@shuddhalekhan/app",
  "private": true,
  "version": "0.0.0-development",
  "description": "Shuddhalekhan — speech-to-text dictation app",
  "type": "module",
  "main": "./out/main/index.cjs",
  "author": "parthashirolkar",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build && bun run build:agent",
    "build:agent": "vite build --config vite.agent.config.ts",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix",
    "test": "bun test --parallel=4",
    "test:watch": "bun test --watch",
    "verify:whisper": "bun scripts/verify-whisper-endpoint.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/azure": "4.0.100",
    "@ai-sdk/mcp": "2.0.10",
    "@ai-sdk/openai": "4.0.92",
    "@ai-sdk/openai-compatible": "3.0.7",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.138",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "js-yaml": "4.1.1",
    "koffi": "^2.9.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "2.0.1",
    "tailwind-merge": "^3.5.0",
    "transcribe-cpp": "0.4.1",
    "ws": "^8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "chart.js": "4.5.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.6",
    "electron-vite": "^5.0.0",
    "oxlint": "1.89.0",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "knip": {
    "entry": [
      "src/main/index.ts",
      "src/preload/index.ts",
      "src/renderer/main.tsx",
      "src/agent/index.ts",
      "src/test/setup.ts"
    ]
  },
  "build": {
    "asarUnpack": [
      "node_modules/**/transcribe-cpp/**/*",
      "node_modules/**/@transcribe-cpp/**/*",
      "node_modules/**/@koromix/**/*",
      "node_modules/**/koffi/**/*"
    ],
    "appId": "com.shuddhalekhan.app",
    "productName": "Shuddhalekhan",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "release-notes.json",
        "to": "release-notes.json"
      },
      {
        "from": "icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/tray-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "PeeeBrain",
      "repo": "shuddhalekhan",
      "releaseType": "draft",
      "publishAutoUpdate": true
    }
  }
}
